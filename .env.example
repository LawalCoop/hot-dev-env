# ========================================
# HOTOSM Development Environment
# ========================================
# Copy this to .env and fill in your values

# ==================
# Shared Services
# ==================

# Cookie secret for Hanko and sessions
# Generate with: openssl rand -base64 32
COOKIE_SECRET=change-me-in-production-must-be-at-least-32-characters-long

# OpenStreetMap OAuth (shared across apps)
# Register at: https://www.openstreetmap.org/oauth2/applications/new
# Redirect URI: http://login.localhost/oauth/callback
OSM_CLIENT_ID=your-osm-client-id
OSM_CLIENT_SECRET=your-osm-client-secret

# Tasking Manager OSM OAuth2 app (scopes: read_prefs write_api)
# Redirect URIs: https://tm.hotosm.test/authorized
#                https://tm.hotosm.test/api/v2/system/authentication/osm/callback/
# TM_CLIENT_ID=
# TM_CLIENT_SECRET=
# Use the OSM dev server so iD/Rapid saves do not hit the real map
# (register the app there: https://master.apis.dev.openstreetmap.org/oauth2/applications/new)
# TM_OSM_SERVER_URL=https://master.apis.dev.openstreetmap.org
# TM_OSM_SERVER_API_URL=https://master.apis.dev.openstreetmap.org

# Google OAuth (for Hanko third-party login)
# Get credentials from Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Admin emails (comma-separated list)
# Users with these emails can access admin endpoints
ADMIN_EMAILS=admin@hotosm.org,youremail@example.com

# ==================
# Optional: Custom Hanko Configuration
# ==================
# These are set automatically by docker-compose.yml
# Uncomment to override

# HANKO_DATABASE_URL=postgres://hanko:hanko@hanko-db:5432/hanko?sslmode=disable
# HANKO_COOKIE_DOMAIN=localhost

# ==================
# Authentication Provider
# ==================
# Options: hanko (default), legacy
# - hanko: Uses Hanko SSO via login.localhost
# - legacy: Uses original OSM OAuth directly
AUTH_PROVIDER=hanko

# ==================
# Optional: Development Overrides
# ==================
# Uncomment if you need to override defaults

# Portal backend port (default: proxied via Traefik)
# PORTAL_BACKEND_PORT=8000

# Drone-TM backend port (default: proxied via Traefik)
# DRONETM_BACKEND_PORT=8000

# MinIO credentials (default: dtm_user / somelongpassword)
# S3_ACCESS_KEY=dtm_user
# S3_SECRET_KEY=somelongpassword
